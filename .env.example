# ResoX Backend Environment Configuration

# Server Port
PORT=5000

# Supabase PostgreSQL Configuration
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# IMPORTANT: Use the service_role key for backend operations so row-level access can be safely managed server-side
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# JWT Secret for signing access tokens (e.g. generate with `openssl rand -hex 32`)
JWT_SECRET=your_jwt_super_secret_key_minimum_32_characters

# Google Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173
